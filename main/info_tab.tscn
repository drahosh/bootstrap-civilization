metadata/_tab_index = 1

[node name="RichTextLabel" type="RichTextLabel" parent="Resources"]
layout_mode = 2
text = "The beings you're influencing can accumulate things. 
	Food - everyone person needs 1 per year. If they don't have enough, this increases their birth rate and death rate. By default, it decays at 10% per year.
	Clothes - Having them reduces death rate by up to 10%.  Each person uses one unit per year. Only 10% of clothes used are destroyed. 
	Culture - immaterial resource representing the organisation of society. it naturally decays at the rate of 1% per year."

[node name="Jobs" type="MarginContainer" parent="."]
visible = false
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 0
metadata/_tab_index = 2

[node name="RichTextLabel" type="RichTextLabel" parent="Jobs"]
layout_mode = 2
text = "The people you control can do things. These are the things that produce and consume resources. 
Jobs are filled by workforce from top to bottom. You can drag and drop them to reorder them. (You can also drag and drop tabs to reorder them, including the job tab, though this doesn't do anything)
You can also set maximum capacity percentage to be used.
If you expand a job to size 10, you unlock capacity upgrades for that job. To unlock more upgrades, you need to research corresponding technologies.

Jobs can have multipliers to capacity, input and output. These multipliers apply multiplicatively, meaning if a job has 3 upgrades, one increasing capacity by 10%, one by 20%, and one reducing it by 10%, the final capacity multiplier will be 1.1*1.2*0.9=1.188, increasing capacity by 18.8%"

