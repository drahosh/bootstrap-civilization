[node name="RichTextLabel" type="RichTextLabel" parent="You"]
layout_mode = 2
text = "Your conciousness begins.
 You don't know what you are. You can sense, though you don't know how, some people. 
You realize you can influence them. You realize you are in them. Multiply them to increase your power."

[node name="Resources" type="MarginContainer" parent="."]
visible = false
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 10
